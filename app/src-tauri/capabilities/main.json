{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The only capability: the main window may call the twenty-one reviewed app commands. No core plugins, no shell, fs, http, opener or updater.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-list-wallets",
    "allow-add-wallet",
    "allow-remove-wallet",
    "allow-get-portfolio",
    "allow-app-info",
    "allow-get-progress",
    "allow-get-activity",
    "allow-auth-status",
    "allow-setup-begin",
    "allow-setup-finish",
    "allow-unlock",
    "allow-lock",
    "allow-startup-checks",
    "allow-get-receive",
    "allow-preview-signer-wallet",
    "allow-add-signer-wallet",
    "allow-get-audit-log",
    "allow-get-address-book",
    "allow-add-address-book-entry",
    "allow-remove-address-book-entry",
    "allow-rename-address-book-entry"
  ]
}
